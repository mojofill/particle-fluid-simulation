#version 450

#define WORKGROUP_SIZE_X 128
layout (local_size_x = WORKGROUP_SIZE_X) in;
layout(binding = 0) uniform UniformBufferObject {
    mat4 model;
    mat4 view;
    mat4 proj;
    int numParticles;
    float particleRadius;
    float smoothingRadius;
    float g;
    vec3 minXYZ;
    float dt;
    vec3 maxXYZ;
    float pad0;
    float particleMass;
    float pressureMultiplier;
    float targetDensity;
    float viscosityStrength;
};
struct CellEntry {
    uint key;
    uint particleIndex;
};
layout (binding = 1, rgba32f) uniform writeonly image2D outputImage;
layout (std430, binding = 2) buffer PositionsBuffer           { vec4 positions[]; };
layout (std430, binding = 3) buffer VelocitiesBuffer          { vec4 velocities[]; };
layout (std430, binding = 4) buffer PredictedPositionsBuffer  { vec4 predictedPositions[]; };
layout (std430, binding = 5) buffer PredictedVelocitiesBuffer { vec4 predictedVelocities[]; };
layout (std430, binding = 6) buffer CellEntriesBuffer         { CellEntry cellEntries[]; };
layout (std430, binding = 7) buffer DensitiesBuffer           { float densities[]; };
layout (std430, binding = 8) buffer StartIndices              { int startIndices[]; };
layout (std430, binding = 9) buffer ColorBuffer               { vec4 colors[]; };

uint cellCoordToHash(uvec3 cellCoord) {
    uvec3 cell = uvec3(cellCoord);

    uint h =
        cell.x * 73856093u ^
        cell.y * 19349663u ^
        cell.z * 83492791u;

    // Avalanche finalizer
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;

    return h;
}

uint cellHashToKey(uint cellHash) {
    // numParticles must be a power of two
    return cellHash & uint(numParticles - 1);
}

uint cellCoordToKey(uvec3 cellCoord) {
    return cellHashToKey(cellCoordToHash(cellCoord));
}

uint samplePointToKey(vec3 point) {
    if (any(lessThan(point, minXYZ)) || any(greaterThan(point, maxXYZ))) return -1;
    ivec3 cellCoord = ivec3(floor((point - minXYZ) / smoothingRadius));
    return cellCoordToKey(cellCoord);
}

const float dt_scale = 1.0;

void main() {
    if (gl_GlobalInvocationID.x >= numParticles) return;

    uint particleIndex = gl_GlobalInvocationID.x;
    vec3 pos = positions[particleIndex].xyz;
    vec3 vel = velocities[particleIndex].xyz;
    
    vel += vec3(0, 0, -g) * dt;
    pos += vel * dt * dt_scale;

    if (pos.x < minXYZ.x + particleRadius) {
        pos.x = minXYZ.x + particleRadius;
        vel.x *= -1;
        vel *= 1.00;
    }
    else if (pos.x > maxXYZ.x - particleRadius) {
        pos.x = maxXYZ.x - particleRadius;
        vel.x *= -1;
        vel *= 1.00;
    }

    if (pos.y < minXYZ.y + particleRadius) {
        pos.y = minXYZ.y + particleRadius;
        vel.y *= -1;
        vel *= 1.00;
    }
    else if (pos.y > maxXYZ.y - particleRadius) {
        pos.y = maxXYZ.y - particleRadius;
        vel.y *= -1;
        vel *= 1.00;
    }

    if (pos.z < minXYZ.z + particleRadius) {
        pos.z = minXYZ.z + particleRadius;
        vel.z *= -1;
        vel *= 0.95;
    }
    else if (pos.z > maxXYZ.z - particleRadius) {
        pos.z = maxXYZ.z - particleRadius;
        vel.z *= -1;
        vel *= 1.00;
        // dont reduce energy coming from top
    }

    velocities[particleIndex] = vec4(vel, 1);
    positions[particleIndex] = vec4(pos, 1);

    float speed = length(vel);
    float t = clamp(speed / 30.0, 0.0, 1.0);

    vec3 color;

    if (t < 0.33) {
        color = mix(vec3(0.3, 0.3, 1.0),    // Blue
                    vec3(0.0, 1.0, 1.0),    // Cyan
                    t / 0.33);
    }
    else if (t < 0.66) {
        color = mix(vec3(0.0, 1.0, 1.0),    // Cyan
                    vec3(1.0, 1.0, 0.0),    // Yellow
                    (t - 0.33) / 0.33);
    }
    else {
        color = mix(vec3(1.0, 1.0, 0.0),    // Yellow
                    vec3(1.0, 0.3, 0.3),    // Red
                    (t - 0.66) / 0.34);
    }

    colors[particleIndex] = vec4(color, 1.0);
    // colors[particleIndex] = vec4(0, 1, 1, 0);
}
