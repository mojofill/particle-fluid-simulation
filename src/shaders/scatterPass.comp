#version 450

#define WORKGROUP_SIZE_X 128
layout (local_size_x = WORKGROUP_SIZE_X) in; // 1024 threads is the hardware limit
layout(binding = 0) uniform UniformBufferObject {
    mat4 model;
    mat4 view;
    mat4 proj;
    int numParticles;
    float particleRadius;
    float smoothingRadius;
    float g;
    vec3 minXYZ;
    float dt;
    vec3 maxXYZ;
    float pad0;
    float particleMass;
    float pressureMultiplier;
    float targetDensity;
    float viscosityStrength;
};
struct CellEntry {
    uint key;
    uint particleIndex;
};
layout (binding = 1, rgba32f) uniform writeonly image2D outputImage;
layout (std430, binding = 2) buffer PositionsBuffer           { vec4 positions[]; };
layout (std430, binding = 3) buffer VelocitiesBuffer          { vec4 velocities[]; };
layout (std430, binding = 4) buffer PredictedPositionsBuffer  { vec4 predictedPositions[]; };
layout (std430, binding = 5) buffer PredictedVelocitiesBuffer { vec4 predictedVelocities[]; };
layout (std430, binding = 6) buffer CellEntriesBuffer         { CellEntry cellEntries[]; };
layout (std430, binding = 7) buffer DensitiesBuffer           { float densities[]; };
layout (std430, binding = 8) buffer StartIndices              { int startIndices[]; };
layout (std430, binding = 9) buffer ColorBuffer               { vec4 colors[]; };

// outputs
layout (std430, binding = 10) buffer PositionsOutputBuffer           { vec4 positionsOutput[]; };
layout (std430, binding = 11) buffer VelocitiesOutputBuffer          { vec4 velocitiesOutput[]; };
layout (std430, binding = 12) buffer PredictedPositionsOutputBuffer  { vec4 predictedPositionsOutput[]; };
layout (std430, binding = 13) buffer PredictedVelocitiesOutputBuffer { vec4 predictedVelocitiesOutput[]; };
layout (std430, binding = 14) buffer DensitiesOutputBuffer           { float densitiesOutput[]; };
layout (std430, binding = 15) buffer ColorOutputBuffer               { vec4 colorsOutput[]; };
layout (std430, binding = 16) buffer CellEntriesOutputBuffer         { CellEntry cellEntriesOutput[]; };

// this is after ive already written all the above, im not going to shift all the bindings bro
// 17 = histograms, 18 = endIndices
layout (std430, binding = 19) buffer NearDensitiesBuffer             { float nearDensities[]; };
layout (std430, binding = 20) buffer NearDensitiesOutputBuffer       { float nearDensitiesOutput[]; };

void main() {
    if (gl_GlobalInvocationID.x >= numParticles) return;

    uint particleIndex = gl_GlobalInvocationID.x;
    uint oldParticleIndex = cellEntries[particleIndex].particleIndex;

    positionsOutput[particleIndex] = positions[oldParticleIndex];
    velocitiesOutput[particleIndex] = velocities[oldParticleIndex];
    predictedPositionsOutput[particleIndex] = predictedPositions[oldParticleIndex];
    predictedVelocitiesOutput[particleIndex] = predictedVelocities[oldParticleIndex];
    densitiesOutput[particleIndex] = densities[oldParticleIndex];
    colorsOutput[particleIndex] = colors[oldParticleIndex];
    nearDensitiesOutput[particleIndex] = nearDensities[particleIndex];

    cellEntries[particleIndex].particleIndex = particleIndex;
}
