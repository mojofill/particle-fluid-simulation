#version 450

#define WORKGROUP_SIZE_X 128
layout (local_size_x = WORKGROUP_SIZE_X) in;
layout(binding = 0) uniform UniformBufferObject {
    mat4 model;
    mat4 view;
    mat4 proj;
    int numParticles;
    float particleRadius;
    float smoothingRadius;
    float g;
    vec3 minXYZ;
    float dt;
    vec3 maxXYZ;
    float pad0;
    float particleMass;
    float pressureMultiplier;
    float targetDensity;
    float viscosityStrength;
};
struct CellEntry {
    uint key;
    uint particleIndex;
};
layout (binding = 1, rgba32f) uniform writeonly image2D outputImage;
layout (std430, binding = 2)  buffer PositionsBuffer           { vec4 positions[]; };
layout (std430, binding = 3)  buffer VelocitiesBuffer          { vec4 velocities[]; };
layout (std430, binding = 4)  buffer PredictedPositionsBuffer  { vec4 predictedPositions[]; };
layout (std430, binding = 5)  buffer PredictedVelocitiesBuffer { vec4 predictedVelocities[]; };
layout (std430, binding = 6)  buffer CellEntriesBuffer         { CellEntry cellEntries[]; };
layout (std430, binding = 7)  buffer DensitiesBuffer           { float densities[]; };
layout (std430, binding = 8)  buffer StartIndices              { int startIndices[]; };
layout (std430, binding = 9)  buffer ColorBuffer               { vec4 colors[]; };
// ... buffers in between are for ping pong, which arent needed in this shader
layout (std430, binding = 18) buffer EndIndicesBuffer          { int endIndices[]; };

uint cellCoordToHash(uvec3 cellCoord) {
    uvec3 cell = uvec3(cellCoord);

    uint h =
        cell.x * 73856093u ^
        cell.y * 19349663u ^
        cell.z * 83492791u;

    // Avalanche finalizer
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;

    return h;
}

uint cellHashToKey(uint cellHash) {
    // numParticles must be a power of two
    return cellHash & uint(numParticles - 1);
}

uint cellCoordToKey(uvec3 cellCoord) {
    return cellHashToKey(cellCoordToHash(cellCoord));
}

ivec3 samplePointToCellCoord(vec3 point) {
    if (any(lessThan(point, minXYZ)) || any(greaterThan(point, maxXYZ))) return ivec3(-1);
    ivec3 cellCoord = ivec3(floor((point - minXYZ) / smoothingRadius));
    return cellCoord;
}

uint samplePointToKey(vec3 point) {
    if (any(lessThan(point, minXYZ)) || any(greaterThan(point, maxXYZ))) return -1;
    ivec3 cellCoord = ivec3(floor((point - minXYZ) / smoothingRadius));
    return cellCoordToKey(cellCoord);
}

const float PI = 3.14159265359f;

float smoothingKernelDerivative(float dist) {
    if (dist >= smoothingRadius) return 0.0f;
    
    // Scale factor derived from dividing the raw derivative 2*(dist - R) 
    // by the 3D volume integration (2 * PI * R^5) / 15
    float scale = 15.0f / (PI * pow(smoothingRadius, 5));
    return (dist - smoothingRadius) * scale;
}

float viscositySmoothingKernel(float dist) {
    if (dist >= smoothingRadius) return 0;

    return (smoothingRadius - dist) * (smoothingRadius - dist);
}

float convertDensityToPressure(float density) { // experiment with better conversions
    float densityError = density - targetDensity;
    float pressure = densityError * pressureMultiplier;
    return pressure;
}

float calculateSharedPressure(float densityA, float densityB) {
    float pressureA = convertDensityToPressure(densityA);
    float pressureB = convertDensityToPressure(densityB);
    return (pressureA + pressureB) / 2;
}

void calculatePressureAndViscosityForce(int particleIndex, out vec3 pressureForce, out vec3 viscosityForce) {
    vec3 samplePoint = predictedPositions[particleIndex].xyz;
    vec3 particleVelocity = velocities[particleIndex].xyz;
    pressureForce = vec3(0);
    viscosityForce = vec3(0);
    float myDensity = densities[particleIndex];
    float R2 = smoothingRadius * smoothingRadius;
    ivec3 particleCell = samplePointToCellCoord(samplePoint);
    for (int dz = -1; dz <= 1; dz++) {
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                ivec3 cellCoord = particleCell + ivec3(dx, dy, dz);
                uint cellKey = cellCoordToKey(uvec3(cellCoord));
                if (cellKey == -1) continue; // skip this cell, its out of bounds
                int startIndex = startIndices[cellKey];
                if (startIndex == -1) continue;
                int endIndex = endIndices[cellKey];
                for (int i = startIndex; i < endIndex; i++) {
                    if (i == particleIndex) continue; // skip itself
                    vec3 particlePosition = predictedPositions[i].xyz;
                    vec3 d = particlePosition - samplePoint;
                    float dist2 = dot(d, d);
                    if (dist2 > R2) continue;
                    float dist = sqrt(dist2);
                    vec3 dir = abs(dist) < 1e-4 ? 
                        vec3(0, 0, 1) :  // fuck it why not man. idk anymore just try this for now
                        d / dist;
                    float slope = smoothingKernelDerivative(dist); // essentially get second order intensity
                    float density = densities[i];
                    float sharedPressure = calculateSharedPressure(density, myDensity); // calculated shared pressure between this particle at particleIndex and the other particle
                    vec3 contribution = sharedPressure * slope * particleMass / density * dir;
                    pressureForce = pressureForce + contribution;

                    float influence = viscositySmoothingKernel(dist);
                    viscosityForce = viscosityForce + particleMass * influence / densities[i] * (velocities[i].xyz - particleVelocity);
                }
            }
        }
    }
}

void main() {
    if (gl_GlobalInvocationID.x >= numParticles) return;

    int particleIndex = int(gl_GlobalInvocationID.x);
    vec3 pressureForce;
    vec3 viscosityForce;
    calculatePressureAndViscosityForce(particleIndex, pressureForce, viscosityForce);
    velocities[particleIndex] += vec4((pressureForce + viscosityForce) / densities[particleIndex] * dt, 1);
}